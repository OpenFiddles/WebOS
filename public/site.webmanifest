{
  "id": "/",
  "name": "WebOS",
  "short_name": "WebOS",
  "description": "A browser-based desktop environment by OpenFiddles.",
  "lang": "en-US",
  "dir": "ltr",
  "start_url": "/?utm_source=pwa",
  "scope": "/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone", "minimal-ui"],
  "orientation": "any",
  "background_color": "#E25822",
  "theme_color": "#E25822",
  "categories": ["productivity", "utilities"],
  "prefer_related_applications": false,
  "icons": [
    { "src": "/images/icons/1.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/images/icons/2.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/images/icons/3.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "launch_handler": { "client_mode": ["focus-existing", "auto"] },
  "file_handlers": [
    {
      "action": "/?action=open-file",
      "name": "Open in WebOS",
      "accept": {
        "text/plain": [".txt", ".md", ".log", ".csv"],
        "application/json": [".json"],
        "application/pdf": [".pdf"],
        "image/png": [".png"],
        "image/jpeg": [".jpg", ".jpeg"],
        "image/webp": [".webp"],
        "image/svg+xml": [".svg"],
        "application/zip": [".zip"]
      }
    }
  ],
  "share_target": {
    "action": "/?action=share",
    "method": "GET",
    "enctype": "application/x-www-form-urlencoded",
    "params": { "title": "title", "text": "text", "url": "url" }
  },
  "note_taking": { "new_note_url": "/?app=notes&new=true" },
  "edge_side_panel": { "preferred_width": 420 },
  "screenshots": [
    { "src": "/images/wiki/desktop1.jpeg", "sizes": "1280x720", "type": "image/jpeg", "form_factor": "wide", "label": "WebOS desktop" },
    { "src": "/images/wiki/desktop2.jpeg", "sizes": "720x1280", "type": "image/jpeg", "form_factor": "narrow", "label": "WebOS mobile layout" }
  ],
  "shortcuts": [
    {
      "name": "About WebOS",
      "short_name": "About",
      "description": "Learn about WebOS and OpenFiddles",
      "url": "/page/what_is.html?utm_source=pwa_shortcut",
      "icons": [{ "src": "/images/icons/1.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "Open Files",
      "short_name": "Files",
      "description": "Open the WebOS file manager",
      "url": "/?app=files",
      "icons": [{ "src": "/images/icons/1.png", "sizes": "192x192", "type": "image/png" }]
    }
  ]
}